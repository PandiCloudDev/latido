# Configuración de Latido. Cópiala como .env y ajústala (o ejecuta node scripts/init-env.ts, que genera .env con claves aleatorias).
# El frontend solo recibe la dirección del sitio; todas las claves se quedan en el backend. No subas .env a Git.

# ===== Obligatorio =====

# Dirección pública del sitio: la usan los enlaces generados, el RSS, las imágenes para compartir y el MCP. Para probar en local usa esta.
SITE_URL=http://localhost:3000

# Contraseña de administrador (al menos 12 caracteres) para entrar a /admin.
ADMIN_PASSWORD=

# Claves para firmar las sesiones y el proxy de imágenes; una cadena aleatoria cada una (por ejemplo con openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Contraseña de la base de datos con Docker (la base no expone puertos; usa también una cadena aleatoria).
POSTGRES_PASSWORD=

# Modelo: sirve cualquier API compatible con OpenAI y todos los pasos la usan de forma predeterminada. Así se configura DeepSeek.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parámetros propios del proveedor (JSON), por ejemplo para apagar el modo de razonamiento:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Ejemplos de otros proveedores:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1                      LLM_MODEL=<proveedor/modelo>
# Actívalo si el modelo puede ver imágenes (el titular y resumen de las notas seleccionadas tomarán en cuenta la primera imagen):
# LLM_VISION=true
# Apágalo si el servicio no admite el modo JSON (response_format):
# LLM_JSON_MODE=false
# Para modelos de razonamiento (piensan antes de responder y comparten el límite de salida entre razonamiento y respuesta): tokens extra
# de salida reservados para razonar, que se suman al límite de cada paso; vacío equivale a 0.
# Defínelo cuando aparezca "output token limit reached (finish_reason=length)", por ejemplo:
# LLM_REASONING_TOKENS=4000

# ===== Opcional: agrupación de eventos más precisa =====

# Búsqueda por vectores: cualquier interfaz /embeddings compatible con OpenAI. Sin ella el sitio funciona y busca candidatos por
# coincidencia de texto, pero las discusiones que solo aportan temperatura (fuentes hot_signal) casi no se cuelgan de eventos y la temperatura queda baja.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# O llena solo la clave de Alibaba Cloud Model Studio para usar text-embedding-v4:
# DASHSCOPE_API_KEY=
# Dimensiones de los vectores (con EMBEDDING_* se toma la que devuelve el servicio; Model Studio usa 1024). Al cambiarla se recalculan los vectores:
# EMBEDDING_DIMS=

# ===== Opcional: un modelo distinto por paso =====
# De forma predeterminada todos los pasos usan LLM_*. Para que un paso use otro proveedor, escribe el nombre del preajuste (requiere su clave):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Preajustes y claves necesarias:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Atención: si llenas DASHSCOPE_API_KEY y no EMBEDDING_API_KEY, la agrupación usará los vectores de Model Studio (text-embedding-v4), que se cobran aparte.

# ===== Opcional: servicios de recolección de pago (cobro por petición, con límites de presupuesto en "Configuración" del panel) =====
# Cuentas de X (Twitter): SocialData
# SOCIALDATA_API_KEY=
# Cuentas públicas de WeChat: Dajiala
# DAJIALA_KEY=
# Renderizado con navegador cuando no se obtiene el cuerpo: Jina Reader
# JINA_API_KEY=

# ===== Opcional: Feishu =====
# Envío de la selección a un grupo de Feishu (solo notas de fuentes T1 y T1_5): se activa en "Configuración → Destinos de notificación" y el webhook va aquí.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alertas y comentarios reenviados a un grupo interno de Feishu (los comentarios requieren una aplicación propia de Feishu):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Las alertas, solo de texto, también pueden ir al bot personalizado de un grupo: si se llena, las alertas salen por webhook y no por la aplicación ni el ID de grupo de arriba (sin consumir llamadas de la aplicación).
# FEISHU_ALERT_WEBHOOK_URL=
# Las alertas pueden pasar primero por tu propio servicio de atención automática (por ejemplo, un relevo de webhooks que despierte a un agente de IA); solo se usa con ambos valores y FEISHU_INTERNAL_ENABLED=true:
# las alertas por atender se envían por POST a esta dirección (Authorization: Bearer <KEY>, JSON con id, type, subject, summary, detail, link), un 200 significa recibida y un mismo id puede reenviarse;
# las alertas, recuperaciones e informes diarios dirigidos a ti van antes por POST a /tell en la raíz del mismo host (JSON con key y text) y, si no se reciben, salen por Feishu. Comportamiento en "Actualizaciones" de docs/deploy.md.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# Inicio de sesión del panel con cuenta de Feishu (opcional, convive con la contraseña de administrador):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Opcional: otros =====
# Las fuentes JSON que leen la API de GitHub (api.github.com) obtienen más cuota con esto. Es gratuito y basta con permiso de solo lectura:
# GITHUB_TOKEN=
# Token para que scripts externos envíen contenido (POST /api/ingest/items), de al menos 16 caracteres; sin él la interfaz queda cerrada.
# INGEST_TOKEN=
# Envíos máximos por minuto y por cliente en esa interfaz (10 con docker compose); si el proxy inverso ya limita, puede ser 0:
# INGEST_RATE_LIMIT=10
# Proxy para leer fuentes del extranjero cuando el servidor tiene la red restringida:
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Si un feed o listado usa un servicio propio en la red interna (por ejemplo RSSHub en la misma red de Docker), escribe sus hosts completos separados por comas (sin distinguir mayúsculas ni comodines).
# Solo se permiten esas direcciones, en conexión directa y sin el proxy anterior; los saltos a otros hosts, el cuerpo de los artículos y las imágenes siguen sin poder usar la red interna, y las direcciones de enlace local y de metadatos de nube se rechazan siempre:
# PRIVATE_FEED_HOSTS=rsshub
# Límite de tráfico del proxy de imágenes hacia los sitios originales (MB por minuto, GB por día); al superarlo, las imágenes sin caché devuelven 503. Sin valor se usa DEPLOYMENT.imageUpstreamBudget de site/site.ts, que de forma predeterminada no tiene límite:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Ponlo en true si hay un proxy inverso como Caddy o Nginx enfrente, para leer la IP del visitante de X-Forwarded-For;
# con el sitio expuesto directamente déjalo en false, para que nadie falsifique su IP y evada los límites de inicio de sesión y de comentarios.
TRUST_PROXY=false
# El MCP solo acepta peticiones dirigidas al dominio de SITE_URL (y a localhost); si hay otros dominios de acceso, escríbelos aquí separados por comas:
# MCP_ALLOWED_HOSTS=
# Minutos sin contenido nuevo para considerar que el sitio "dejó de recibir notas" y alertar; sin valor se usa ALERTS.quietMinutes de site/site.ts (360 de forma predeterminada):
# ALERT_QUIET_MINUTES=360
# Envío diario de páginas nuevas a IndexNow (Bing y otros); la clave es de 32 caracteres hexadecimales, genérala tú:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Respaldo diario de la base en un almacenamiento de objetos compatible con S3 (Tencent COS, AWS S3, Alibaba OSS, Cloudflare R2…).
# Sin DB_BACKUP_STORE_DOMAIN la dirección se arma con el formato de Tencent COS (<bucket>.cos.<región>.myqcloud.com);
# con otro proveedor escribe el dominio de acceso con el nombre del bucket, por ejemplo en AWS S3 my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Nivel de registro (info de forma predeterminada) y máximo de conexiones a la base (10 de forma predeterminada):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Nombre de la versión: aparece en la página "Ejecuciones" del panel y en /api/health, para confirmar que los procesos se actualizaron:
# AIHOT_RELEASE=
# Nombre del entorno; de forma predeterminada production o development según NODE_ENV. Fuera de production las alertas lo incluyen y solo ahí funciona el acceso de desarrollo sin inicio de sesión:
# AIHOT_ENVIRONMENT=
# Directorio con las claves agrupadas en archivos (models.env, collectors.env, integrations.env, auth.env) en lugar de escribirlas aquí; lo escrito aquí tiene prioridad:
# AIHOT_CREDENTIALS_DIR=

# ===== Válvulas de seguridad =====
# Solo con true se leen fuentes (incluidos los íconos diarios de las fuentes) y se llama al modelo; si borras estas dos líneas o pones false, todo se detiene (útil al depurar la interfaz).
# Todos los interruptores *_ENABLED de este archivo solo aceptan true; 1, yes o TRUE cuentan como apagado.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Solo sin Docker, ejecutando directamente en la máquina =====
# DATABASE_URL=postgres://tu_usuario@127.0.0.1:5432/latido
# API_BASE_URL=http://127.0.0.1:3001
# Directorio para archivos subidos, caché de imágenes y respaldos locales (de forma predeterminada .data dentro del repositorio):
# AIHOT_DATA_DIR=/var/lib/latido
# Acceso al panel sin iniciar sesión durante el desarrollo (producción se niega a arrancar con esto) y el nombre que muestra el panel:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Permite leer direcciones internas al depurar en local (prohibido de forma predeterminada; producción se niega a arrancar con esto):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== Con docker compose --profile https =====
# SITE_DOMAIN=example.com
# Puerto local del sitio (lo usa docker compose; 3000 de forma predeterminada, accesible desde todas las interfaces). Con HTTPS solo lo usa Caddy en la propia máquina y no se expone:
# PORT=127.0.0.1:3000
# Cambia también TRUST_PROXY de arriba a true.
